# Welche Routing-Engine laeuft: brouter (Default) oder ors.
# brouter braucht keinen Key und kann als einzige den Netz-Regler.
ROUTING_ENGINE=brouter

# OpenRouteService API-Key (https://account.heigit.org)
# Server-only — niemals mit NEXT_PUBLIC_ prefixen.
# Noetig fuer: die Ortssuche (immer) und ROUTING_ENGINE=ors (Fallback-Routing).
# Ohne Key funktionieren Karte, Klick-Start und Routing ueber BRouter weiterhin.
ORS_API_KEY=
